# Copy to .env and fill in. .env is ignored by git.

# --- Answers (Anthropic) ---
ANTHROPIC_API_KEY=

# --- Embeddings (any OpenAI-compatible /embeddings endpoint; OpenAI by default) ---
# Without EMBED_API_KEY the offline hashing embedder is used (fine for tests, weak for real use).
EMBED_API_KEY=
EMBED_MODEL=text-embedding-3-small
EMBED_BASE_URL=https://api.openai.com/v1

# --- Local Postgres + pgvector (docker compose up -d db) ---
# Any long random password. It is used by docker-compose.yml and by the app.
RAG_DB_PASSWORD=
# Optional overrides (defaults shown):
# RAG_DB_HOST=127.0.0.1
# RAG_DB_PORT=5433
# RAG_DB_NAME=rag
# RAG_DB_USER=rag
